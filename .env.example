# Copy to .env (local use) AND store the same content as a Jenkins "Secret file"
# credential with ID: shop-env-file
REGISTRY=localhost:5000
# Host port for the shop (nginx). Change if 8080 is already in use.
HTTP_PORT=8088
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=shop
# Optional: POST a JSON deploy event here (Slack-compatible incoming webhook, etc.)
# DEPLOY_WEBHOOK_URL=
